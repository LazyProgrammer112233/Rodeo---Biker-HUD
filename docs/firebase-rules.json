{
  "rules": {
    "packs": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('lead').val() === auth.uid)"
        },
        "members": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 24)"
          }
        },
        "voice": {
          ".read": "auth != null",
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        },
        "signal": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            ".write": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid"
            }
          }
        }
      }
    },
    "hazards": {
      "$cell": {
        ".read": "auth != null",
        "$id": { ".write": "auth != null" }
      }
    }
  }
}
